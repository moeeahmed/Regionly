# Required
DATABASE_URL=postgres://...            # Neon (Vercel Marketplace sets this for you)
SESSION_SECRET=change-me-to-32-random-chars
BLOB_READ_WRITE_TOKEN=                 # set automatically when a Blob store is connected
ELEVENLABS_API_KEY=
# Paste the key exactly as the Higgsfield console shows it (usually keyid:secret)
HIGGSFIELD_API_KEY_ID=
ANTHROPIC_API_KEY=

# Optional
APP_URL=https://your-domain.com        # public URL used for Higgsfield webhooks + Stripe redirects
CRON_SECRET=
SIGNUP_CREDITS=30
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v2
ANTHROPIC_MODEL=claude-sonnet-5-5
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.0/reference-to-video

# Stripe billing. Prices are created at checkout; the STRIPE_PRICE_ vars below are optional overrides.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                 # endpoint: https://your-domain/api/webhooks/stripe
STRIPE_PRICE_STARTER=                  # recurring price, 200 credits / month
STRIPE_PRICE_GROWTH=                   # recurring price, 800 credits / month
STRIPE_PRICE_PACK=                     # one-time price, 100 credits

# Shown on the legal and contact pages
LEGAL_ENTITY=                          # registered company name
LEGAL_ADDRESS=                         # registered address
CONTACT_EMAIL=
